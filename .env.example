# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# Required: the host's stable advertised address (global IPv6 recommended).
SERVER_ADVERTISE_IP=

# Required: paths you supply (absolute paths on the host).
CHIV_GAME=/srv/chiv-x64/game
CLI_DIR=/srv/chiv-x64/cli
LOCAL_REGISTRY=/srv/chiv-x64/cli/local-registry3
PROTON_DIR=/srv/chiv-x64/proton/GE-Proton11-11-x86_64
COMPAT_CLIENT_DIR=/srv/chiv-x64/proton/compat-client
# Holds Epic/legendary credentials. Keep it OUT of git.
LEGENDARY_CONFIG=/srv/chiv-x64/legendary-config

# Optional overrides (defaults shown).
# SERVER_NAME=x64 EGS CLI server
# SERVER_BROWSER_BACKEND=https://servers.polehammer.net
# GAME_PORT=7777
# PING_PORT=3075
# QUERY_PORT=7071
# RCON_PORT=9001
# DISPLAY_NUM=99
# CHIV_PREFIX=./state/prefix
# CHIV_LOCALAPPDATA=./state/appdata
