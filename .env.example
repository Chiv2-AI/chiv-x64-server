# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# Required for the supplied IPv6-enabled Compose profile:
# the host's stable global IPv6 address, raw (no brackets).
# IPv4-only requires a separately adjusted Compose profile; see README.
SERVER_ADVERTISE_IP=

# Required: paths you supply (absolute paths on the host).
CHIV_GAME=/srv/chiv-x64-server/game
CLI_DIR=/srv/chiv-x64-server/cli
LOCAL_REGISTRY=/srv/chiv-x64-server/cli/local-registry3
PROTON_DIR=/srv/chiv-x64-server/proton/GE-Proton11-11-x86_64
COMPAT_CLIENT_DIR=/srv/chiv-x64-server/proton/compat-client
# Holds Epic/legendary credentials. Keep it OUT of git.
LEGENDARY_CONFIG=/srv/chiv-x64-server/legendary-config

# Optional overrides.
# SERVER_NAME=x64 EGS CLI server
# SAVED_DIR_SUFFIX=UnchainedX64
# SERVER_BROWSER_BACKEND=https://servers.polehammer.net
# GAME_PORT=7777
# PING_PORT=3075
# QUERY_PORT=7071
# RCON_PORT=9001
# DISPLAY_NUM=99
# The default state is private to this checkout (./state), ignored by Git.
# Set CONTAINER_NAME / IMAGE_NAME to avoid identity collisions on a shared Docker host.
# CHIV_PREFIX=./state/prefix
# CHIV_LOCALAPPDATA=./state/appdata
# CONTAINER_NAME=chiv-x64
# IMAGE_NAME=chiv-x64-native:local
